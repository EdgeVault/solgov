# Operational scripts and logs (operator-only, not part of public product)
sentinel/scripts/

# Sentinel scratch / forensics tooling (one-off scripts used during development).
# Production daemons and helpers are whitelisted with ! below.
sentinel/src/*.ts
!sentinel/src/solgov-api.ts
!sentinel/src/solgov-bot.ts
!sentinel/src/solgov-listener.ts
!sentinel/src/solgov-monitor.ts
!sentinel/src/activity-log.ts
!sentinel/src/subscriptions.ts
!sentinel/src/llm-client.ts
!sentinel/src/llm-tools.ts
!sentinel/src/llm-triage.ts
!sentinel/src/user-tracked-multisigs.ts
!sentinel/src/webhook-registry.ts
!sentinel/src/test-public-alerts.ts
!sentinel/src/index.ts

# Investigation reports (forensics scratch, not part of the product)
sentinel/src/investigations/

# Sentinel src-level dev README + PowerShell scratch
sentinel/src/README.md
sentinel/src/*.ps1
