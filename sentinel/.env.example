# Helius - RPC endpoint with your API key
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Telegram bot - bot token from @BotFather, chat ID for the target group/topic
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq - for the LLM-powered triage step on critical alerts
GROQ_API_KEY=

# API server - port the public API listens on (default 3847)
SOLGOV_API_PORT=3847

# Webhook signing - HMAC secret for partner webhook deliveries (optional)
WEBHOOK_SECRET=
